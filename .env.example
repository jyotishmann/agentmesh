# file: .env.example

# ── Model Configuration ──────────────────────────────────────────────
# Main model used for Planner and Critic agents
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# Smaller model used for Specialist agents (Research, Coder, Analyst)
SPECIALIST_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# Embedding model for knowledge base and long-term memory
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── Generation Parameters ────────────────────────────────────────────
TEMPERATURE=0.7
MAX_NEW_TOKENS=1024
TOP_P=0.9

# ── Agent Parameters ─────────────────────────────────────────────────
# Max tool calls a single specialist agent can make per sub-task
MAX_TOOL_CALLS_PER_AGENT=5
# Max total tool calls across all agents for a single user task
MAX_TOTAL_TOOL_CALLS=20
# Max revision cycles when the critic rejects output
MAX_REVISION_CYCLES=2
# Number of conversation turns to keep in short-term memory
CONVERSATION_BUFFER_SIZE=20

# ── Tool Configuration ───────────────────────────────────────────────
# Timeout for web search requests (seconds)
SEARCH_TIMEOUT=10
# Timeout for code execution subprocess (seconds)
CODE_EXECUTION_TIMEOUT=30
# Max characters to read from a file
FILE_READ_MAX_CHARS=10000
# Root directory for file I/O sandbox
WORKSPACE_ROOT=./data

# ── Knowledge Base ────────────────────────────────────────────────────
# Directory containing documents to index
KNOWLEDGE_BASE_DIR=./data/knowledge_base
# Number of results to return from vector search
KNOWLEDGE_BASE_TOP_K=5
# Path to the FAISS index file
FAISS_INDEX_PATH=./data/faiss_index.bin

# ── Database ──────────────────────────────────────────────────────────
# SQLite database for trajectories, memory, and eval results
DATABASE_PATH=./data/agentmesh.db

# ── Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# ── Device ────────────────────────────────────────────────────────────
# "cuda" for GPU, "cpu" for CPU-only
DEVICE=cuda